# Reviewlens Sentiment Analyzer - optional configuration.
# Every value below has a working default in app/config.py, so the app boots
# with no .env file at all. Copy to .env only if you want to override.

# Session signing secret. Generated once into data/.session_secret when unset.
SESSION_SECRET=

# Where the SQLite file lives (relative to the repo root is fine).
REVIEWLENS_DB_PATH=data/app.db

# Port for the web server (Gradio's conventional 7860).
PORT=7860

# Session lifetime in hours.
REVIEWLENS_SESSION_HOURS=12
